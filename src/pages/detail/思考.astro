---
import DetailPostLayout from '../../layouts/DetailPostLayout.astro';
---

<DetailPostLayout title="思考模板" description="可直接复用的思考与阅读文章模板" keywords="思考,模板,博客,经济学,沉沦">
	<div class="notice-page">
		<h1>思考文章模板</h1>
		<p>已加入两篇可直接使用的模板，你可以打开后按自己的内容继续改写。</p>
		<p>
			<a href="/blog/经济学" class="notice-link">打开：经济学文章模板</a>
		</p>
		<p>
			<a href="/blog/沉沦阅读模板" class="notice-link">打开：郁达夫《沉沦》阅读模板</a>
		</p>
		<p>
			<a href="/blog" class="notice-link ghost">返回博客列表</a>
		</p>
	</div>
</DetailPostLayout>

<style>
	.notice-page {
		max-width: 720px;
		margin: 2rem auto;
		padding: 1.5rem;
		border-radius: 16px;
		background: rgba(125, 196, 188, 0.1);
		border: 1px solid var(--border);
	}

	.notice-page h1 {
		text-align: left;
		margin: 0 0 0.8rem;
	}

	.notice-page p {
		margin: 0.6rem 0;
		color: var(--color-200);
	}

	.notice-link {
		display: inline-block;
		padding: 0.55rem 1rem;
		border-radius: 999px;
		text-decoration: none;
		border: 1px solid var(--border);
		margin-right: 0.5rem;
	}

	.notice-link.ghost {
		opacity: 0.85;
	}
</style>
